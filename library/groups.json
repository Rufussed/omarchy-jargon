{
  "$schema": "./groups.schema.json",
  "version": 1,
  "description": "Curated Whisper initial_prompt vocabulary for Omarchy Voxtype. Terms are chosen because a small Whisper model mishears them, not merely because they are technical. Terms any model already spells (API, JSON, CSS, HTML, GPU) are deliberately absent: they cost budget and buy nothing.",
  "preamble": "Technical dictation about software development.",
  "groups": {
    "3d": {
      "label": "3D / graphics",
      "description": "glTF pipelines, Blender, real-time rendering.",
      "terms": [
        "glTF",
        "Mixamo",
        "WebGL",
        "mesh",
        "UV",
        "shader",
        "emissive",
        "albedo",
        "viewport",
        "bounding box",
        "skinning",
        "rig",
        "LOD",
        "threejs",
        "glb"
      ]
    },
    "web": {
      "label": "Web / frontend",
      "description": "Build tools and browser APIs.",
      "terms": [
        "Vite",
        "TypeScript",
        "WebSocket",
        "WebAssembly",
        "WebP",
        "npm",
        "Tailwind",
        "viewport"
      ]
    },
    "backend": {
      "label": "Backend / data",
      "description": "Servers, databases, schemas.",
      "terms": [
        "Fastify",
        "SQLite",
        "Postgres",
        "Redis",
        "nginx",
        "Docker",
        "Kubernetes",
        "schema",
        "endpoint",
        "webhook"
      ]
    },
    "git": {
      "label": "Git / workflow",
      "description": "Version control verbs that are ordinary English elsewhere.",
      "terms": [
        "repo",
        "rebase",
        "merge",
        "stash",
        "cherry-pick",
        "upstream",
        "squash",
        "diff"
      ]
    },
    "linux": {
      "label": "Linux / Omarchy",
      "description": "This desktop and the system under it.",
      "terms": [
        "Hyprland",
        "Omarchy",
        "Wayland",
        "Arch",
        "pacman",
        "AUR",
        "Voxtype"
      ]
    },
    "ai": {
      "label": "AI / agents",
      "description": "Model and agent vocabulary.",
      "terms": [
        "Claude",
        "Anthropic",
        "LLM",
        "agentic",
        "MCP",
        "Whisper",
        "fine-tune",
        "context window"
      ]
    },
    "core": {
      "label": "Everyday dev",
      "description": "Small, high-frequency words a base model still gets wrong. Cheap; most users want this one.",
      "terms": [
        "cache",
        "config",
        "async",
        "boolean",
        "enum",
        "regex",
        "CLI",
        "stdout",
        "localhost",
        "auth",
        "CSV",
        "UUID",
        "CRUD"
      ]
    }
  }
}
